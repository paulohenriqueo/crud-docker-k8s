# Copie para .env e ajuste. O .env real NUNCA e commitado.
# No Kubernetes estes valores viram ConfigMap (host, porta, banco, usuario)
# e Secret (senhas) — ver k8s/ a partir da Semana 3.

# ---- MySQL ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=crud
MYSQL_USER=crud
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-tambem

# ---- Backend ----
# Origem do frontend autorizada no CORS. Nunca "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
