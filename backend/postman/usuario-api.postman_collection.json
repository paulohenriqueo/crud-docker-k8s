{
  "info": {
    "name": "usuario-api (crud-docker-k8s)",
    "description": "CRUD de usuario. Suba a API antes com `./scripts/dev-backend.sh up`.\n\nA variável `baseUrl` vale http://localhost:8080. Em Kubernetes (Semana 3), troque pela URL do Service/Ingress — nada mais muda.\n\nA pasta 'Erros esperados' NÃO é bug: cada request ali comprova um status de erro correto. Rode a collection inteira pelo Runner: todos devem passar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "usuarioId",
      "value": "",
      "type": "string",
      "description": "Preenchido automaticamente pelo POST de criação."
    },
    {
      "key": "emailUnico",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Endpoints que viram as probes do Deployment na Semana 3.",
      "item": [
        {
          "name": "health geral",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "description": "Status agregado da aplicação."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health/readiness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "readiness"
              ]
            },
            "description": "Se falhar, o Service do K8s para de mandar tráfego para o pod."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health/liveness",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health",
                "liveness"
              ]
            },
            "description": "Se falhar, o kubelet reinicia o container."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "CRUD",
      "description": "Fluxo feliz, na ordem. Rode de cima para baixo.",
      "item": [
        {
          "name": "1. criar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "description": "Espera 201 com header Location. Guarda o id em {{usuarioId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Souza\",\n  \"email\": \"{{emailUnico}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// e-mail único a cada execução, para o teste ser repetível",
                  "pm.collectionVariables.set(\"emailUnico\", `ana+${Date.now()}@exemplo.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"tem header Location\", () => pm.response.to.have.header(\"Location\"));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"usuarioId\", b.id);",
                  "pm.test(\"devolve o recurso criado\", () => pm.expect(b.nome).to.eql(\"Ana Souza\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. listar (paginado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios?page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": "Sempre paginado. O corpo traz 'content' e o objeto 'page' com os metadados."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"tem content\", () => pm.expect(b.content).to.be.an(\"array\"));",
                  "pm.test(\"tem metadados de pagina\", () => pm.expect(b.page.size).to.eql(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. buscar por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "{{usuarioId}}"
              ]
            },
            "description": "Usa o id guardado pelo request 1."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"id confere\", () => pm.expect(String(pm.response.json().id)).to.eql(pm.collectionVariables.get(\"usuarioId\").toString()));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. atualizar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "{{usuarioId}}"
              ]
            },
            "description": "Manter o próprio e-mail é permitido — o conflito só vale contra OUTRO usuário.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Souza Silva\",\n  \"email\": \"{{emailUnico}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"nome atualizado\", () => pm.expect(pm.response.json().nome).to.eql(\"Ana Souza Silva\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. deletar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/{{usuarioId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "{{usuarioId}}"
              ]
            },
            "description": "Espera 204 e corpo vazio — não 200."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));",
                  "pm.test(\"sem corpo\", () => pm.expect(pm.response.text()).to.be.empty);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Erros esperados",
      "description": "Cada request aqui PASSA quando a API devolve o erro certo.",
      "item": [
        {
          "name": "400 — e-mail invalido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "description": "O corpo aponta o campo em 'erros'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Bia\",\n  \"email\": \"nao-e-email\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"aponta o campo email\", () => pm.expect(pm.response.json().erros.email).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "400 — nome em branco",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"   \",\n  \"email\": \"bia@exemplo.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"aponta o campo nome\", () => pm.expect(pm.response.json().erros.nome).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "409 — e-mail duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "description": "Cria um usuário no pre-request e tenta repetir o mesmo e-mail.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Outra pessoa\",\n  \"email\": \"{{emailDuplicado}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = `dup+${Date.now()}@exemplo.com`;",
                  "pm.collectionVariables.set(\"emailDuplicado\", email);",
                  "pm.sendRequest({",
                  "  url: pm.collectionVariables.get(\"baseUrl\") + \"/api/usuarios\",",
                  "  method: \"POST\",",
                  "  header: {\"Content-Type\": \"application/json\"},",
                  "  body: {mode: \"raw\", raw: JSON.stringify({nome: \"Primeira\", email})}",
                  "}, () => {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "404 — GET de id inexistente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "999999"
              ]
            },
            "description": ""
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"mensagem de nao encontrado\", () => pm.expect(pm.response.json().title).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "404 — PUT de id inexistente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "999999"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Fantasma\",\n  \"email\": \"fantasma@exemplo.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "404 — DELETE de id inexistente",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios",
                "999999"
              ]
            },
            "description": "Deletar id inexistente NÃO pode responder 204 — seria sucesso silencioso."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Limites",
      "item": [
        {
          "name": "teto de tamanho de pagina",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/usuarios?size=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "usuarios"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "500"
                }
              ]
            },
            "description": "Pedir 500 itens é servido como 100 (spring.data.web.pageable.max-page-size)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"size limitado a 100\", () => pm.expect(pm.response.json().page.size).to.eql(100));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
